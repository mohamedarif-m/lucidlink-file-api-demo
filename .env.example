# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# ===========================================
# GitHub Integration (for Bob AI Developer)
# ===========================================

# Your GitHub Personal Access Token
# Get it from: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your_github_token_here

# Repository to monitor (format: username/repo-name)
GITHUB_REPO=your-username/lucidlink-file-api-demo

# Branch to work on
GITHUB_DEFAULT_BRANCH=main

# ===========================================
# Server Configuration
# ===========================================

# Port for the API server
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# ===========================================
# Authentication (Optional)
# ===========================================

# Enable API key authentication
REQUIRE_AUTH=false

# API key for authenticated requests
# Generate a secure random string for production
API_KEY=demo_api_key_replace_in_production

# ===========================================
# File Upload Configuration (Optional)
# ===========================================

# Maximum file size in bytes (default: 100MB)
MAX_FILE_SIZE=104857600

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,text/plain

# ===========================================
# Rate Limiting (Optional)
# ===========================================

# Rate limit window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Logging (Optional)
# ===========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ===========================================
# Database (Future Enhancement)
# ===========================================

# Database connection string (when implemented)
# DATABASE_URL=postgresql://user:password@localhost:5432/lucidlink_demo

# ===========================================
# Bob AI Configuration (Optional)
# ===========================================

# Bob's commit author name
BOB_AUTHOR_NAME=Bob AI Developer

# Bob's commit author email
BOB_AUTHOR_EMAIL=bob@example.com

# Enable automatic PR creation
BOB_AUTO_CREATE_PR=true

# Enable automatic issue detection
BOB_AUTO_DETECT_ISSUES=true

# Issue polling interval in seconds
BOB_POLL_INTERVAL=30