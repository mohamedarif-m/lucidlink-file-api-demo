{
  "name": "lucidlink-file-api-demo",
  "version": "1.0.0",
  "description": "File management API demo for LucidLink presentation",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "poll": "node .bob/poller.js",
    "poll:background": "node .bob/poller.js > .bob/polling.log 2>&1 &",
    "auto-executor": "node .bob/auto-executor.js",
    "auto-executor:background": "node .bob/auto-executor.js > .bob/auto-executor.log 2>&1 &",
    "watch-executor": "./watch-auto-executor.sh",
    "demo": "./start-demo.sh"
  },
  "keywords": ["file-management", "api", "demo"],
  "author": "Bob AI Developer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": ["/node_modules/"],
    "testMatch": ["**/tests/**/*.test.js"]
  }
}